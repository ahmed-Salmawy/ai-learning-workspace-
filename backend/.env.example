# Copy to .env and adjust; never commit .env
ALW_ENVIRONMENT=dev
ALW_LOG_LEVEL=INFO
ALW_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/postgres
# ALW_OPENAI_BASE_URL=https://api.openai.com/v1
# ALW_OPENAI_API_KEY=sk-...
# ALW_LLM_MODEL=gpt-4o-mini
# Embeddings — two options:
# 1) local (offline, free): sentence-transformers model, 384-dim columns
ALW_EMBEDDING_PROVIDER=local
ALW_LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
ALW_EMBEDDING_DIMENSION=384
# 2) remote OpenAI-compatible (e.g. ALW_OPENAI_BASE_URL + embedding model):
# ALW_EMBEDDING_PROVIDER=openai
# ALW_EMBEDDING_MODEL=text-embedding-3-small
# ALW_EMBEDDING_DIMENSION=1536  # then run a migration to resize vector columns
ALW_STORAGE_ROOT=var/storage

# PDF text extractor: pymupdf (default, fast) | mineru (layout-aware, figures/tables/headings;
# requires a separate `mineru` CLI install in a Python 3.10-3.13 env — see backend/README.md)
ALW_EXTRACTOR=pymupdf
ALW_MINERU_COMMAND=mineru
ALW_MINERU_BACKEND=pipeline
ALW_MINERU_TIMEOUT=3600
